---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('proyectos');
const homeProjects = allProjects
  .filter((project) => project.data.home)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const allPosts = await getCollection('posts');
const allPublications = await getCollection('publicaciones');

const homePosts = allPosts
  .filter((post) => post.data.showOnHome)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const homePublications = allPublications
  .filter((pub) => pub.data.showOnHome)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const homeNews = homePosts.map((post) => ({
  title: post.data.title,
  image: post.data.imagepost,
  badge: post.data.category || 'Actualidad',
  href: `/posts/${post.id.replace(/\.mdoc$/, '')}`,
  external: false,
}));

const homePublicationsItems = homePublications.map((pub) => ({
  title: pub.data.nombre,
  image: pub.data.imagen,
  tematica: pub.data.tematica,
  href: pub.data.descarga || pub.data.link,
  external: true,
}));
---

<Layout
  title="Inicio | Ciudadanía Inteligente"
  description="Hacemos de la democracia una experiencia compartida, justa y transformadora."
>
  <Navbar />

  <main>
    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-24 md:pt-36 pb-20 md:pb-72">
      <div class="max-w-350 mx-auto px-6 relative">
        <div class="max-w-4xl mx-auto flex flex-col items-center">
          <p class="font-sans font-bold text-h6 md:text-h5 lg:text-[3rem] text-text-primary mb-2">
            Hacemos de la
          </p>
          <h1 class="font-sans font-black text-[3rem] md:text-[6rem] lg:text-[12rem] leading-[0.9] text-text-primary uppercase tracking-tight">
            Democracia
          </h1>
          <p class="font-sans font-bold text-h6 md:text-h5 lg:text-[3rem] text-text-primary leading-headings mt-2 md:text-nowrap">
            una experiencia compartida, justa y transformadora
          </p>
        </div>
      </div>
    </section>

    <!-- About Section (Blue) -->
    <section class="bg-primary text-text-inverse relative md:h-175 overflow-x-clip">
      <!-- Corner/border images -->
      <img
        src="/img/manobordeizquierda.webp"
        alt=""
        aria-hidden="true"
        class="absolute top-0 left-0 -translate-y-1/2 w-32 md:w-48 lg:w-60 pointer-events-none md:animate-slide-in-left"
      />
      <img
        src="/img/manossobrebarraazulmapa.webp"
        alt=""
        aria-hidden="true"
        class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-full w-70 md:w-125 lg:w-192.5 h-21.25 md:h-37.5 lg:h-57.5 pointer-events-none md:animate-fade-in"
      />
      <img
        src="/img/manobordederecho.webp"
        alt=""
        aria-hidden="true"
        class="absolute top-0 right-0 -translate-y-1/2 w-28 md:w-44 lg:w-56 pointer-events-none md:animate-slide-in-right"
      />
      <img
        src="/img/justiciabordeizquierdo.webp"
        alt=""
        aria-hidden="true"
        class="absolute bottom-0 left-0 translate-y-1/2 w-32 md:w-48 lg:w-60 pointer-events-none"
      />
      <img
        src="/img/piezabordederecho.webp"
        alt=""
        aria-hidden="true"
        class="absolute bottom-0 right-0 translate-y-1/2 w-32 md:w-48 lg:w-60 pointer-events-none"
      />

      <!-- Mapa de Latinoamérica -->
      <div class="absolute right-0 top-0 bottom-0 w-1/2 md:w-2/5 lg:w-1/3 pointer-events-none flex items-center justify-end opacity-30 md:opacity-100">
        <img
          src="/img/mapa.webp"
          alt=""
          aria-hidden="true"
          width="665"
          height="892"
          class="h-full w-auto max-w-none"
        />
      </div>

      <div class="max-w-350 mx-auto md:mx-24 lg:mx-32 px-6 relative z-10 flex items-center md:h-175 py-12 md:py-0">
        <div class="max-w-4xl text-left">
          <p class="font-sans text-h5 md:text-h4 font-medium leading-relaxed">
            Trabajamos en América Latina y el Caribe desarrollando herramientas y estrategias para fortalecer <span class="text-accent-green font-bold">la participación ciudadana</span>, <span class="text-accent-green font-bold">la transparencia</span> y <span class="text-accent-green font-bold">la incidencia pública</span>.
          </p>
          <a
            href="/nosotros"
            class="inline-block mt-6 font-sans text-xl font-bold uppercase tracking-wider text-text-primary bg-neutral-white rounded-pill px-6 py-3 no-underline hover:bg-accent-magenta hover:text-text-inverse transition-all duration-fast"
          >
            NOSOTROS
          </a>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section class="relative pt-20 md:pt-48 pb-8 md:pb-24">
      <div class="mx-auto px-6 md:px-0 relative">
        <h2 class="font-sans font-extrabold text-h2 text-text-primary leading-headings uppercase tracking-wide text-center mb-10">
          Nuestros Proyectos
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-0">

          {homeProjects
            
            .map((proyecto) => (
              <a
                href="/proyectos"
                class="aspect-video flex items-center justify-center no-underline group overflow-hidden relative bg-primary"
              >
                {proyecto.data.imagen && (
                  <img
                    src={proyecto.data.imagen}
                    alt={proyecto.data.nombre}
                    class="absolute inset-0 w-full h-full object-cover group-hover:opacity-90 transition-opacity duration-fast"
                    loading="lazy"
                  />
                )}
              </a>
            ))}
        </div>

        <div class="text-center mt-10">
          <a
            href="/proyectos"
            class="inline-block font-sans text-caption font-bold uppercase tracking-wider text-text-inverse bg-primary rounded-pill px-8 py-3 no-underline hover:bg-accent-magenta transition-all duration-fast"
          >
            VER TODOS LOS PROYECTOS
          </a>
        </div>
      </div>
    </section>

    <!-- News Section -->
    <section class="relative pt-8 md:pt-24 pb-16 md:pb-24">
      <div class="max-w-350 mx-auto px-6 relative">
        <p class="font-sans font-medium text-body text-text-primary uppercase tracking-wide text-center mb-2">
          Revisa nuestras
        </p>
        <h2 class="font-sans font-extrabold text-h2 text-text-primary leading-headings uppercase tracking-wide text-center mb-10">
          Últimas Novedades
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {homeNews.map((item) => (
            <article class="bg-bg-gray rounded-lg overflow-hidden flex flex-col">
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="block aspect-4/3 bg-neutral-dark relative overflow-hidden"
              >
                {item.image ? (
                  <img
                    src={item.image}
                    alt={item.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <span class="absolute inset-0 flex items-center justify-center text-text-inverse/30 text-sm">Imagen</span>
                )}
              </a>
              <div class="p-5 flex flex-col grow">
                <div class="mb-5">
                  <span class="inline font-sans text-sm font-medium uppercase tracking-wider text-text-primary bg-sky-300 px-2 py-0.5">
                    {item.badge}
                  </span>
                </div>
              <h3 class="font-sans font-normal text-[20px] text-text-primary leading-tight mb-5 grow">
                  {item.title}
                </h3>
                <a
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                  class="font-sans text-base font-normal  text-fuchsia-600 underline"
                >
                  Leer artículo
                </a>
              </div>
            </article>
          ))}
        </div>

        <div class="text-center mt-10">
          <a
            href="/novedades"
            class="inline-block font-sans text-caption font-bold uppercase tracking-wider text-text-inverse bg-primary rounded-pill px-8 py-3 no-underline hover:bg-accent-magenta transition-all duration-fast"
          >
            VER TODAS LAS NOVEDADES
          </a>
        </div>
      </div>
    </section>

    <!-- Publicaciones Section -->
    <section class="relative pt-8 md:pt-24 pb-16 md:pb-24">
      <div class="max-w-350 mx-auto px-6 relative">
        <p class="font-sans font-medium text-body text-text-primary uppercase tracking-wide text-center mb-2">
          Explora nuestras
        </p>
        <h2 class="font-sans font-extrabold text-h2 text-text-primary leading-headings uppercase tracking-wide text-center mb-10">
          Publicaciones
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
          {homePublicationsItems.map((item) => (
            <article class="relative flex flex-col w-full h-130 md:h-145 max-w-98.5 mx-auto items-center rounded-md bg-bg-default shadow-card overflow-hidden">
              <figure class="pt-4 px-4 shrink-0">
                {item.image ? (
                  <img
                    src={item.image}
                    alt={item.title}
                    class="rounded-sm border border-gray-300 max-h-64 w-auto object-contain"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-64 bg-bg-gray flex items-center justify-center rounded-sm">
                    <span class="text-text-body/40 text-sm">Imagen</span>
                  </div>
                )}
              </figure>
              <div class="flex flex-col items-center text-center mt-4 mx-6 pb-20 grow">
                <p class="font-['Work_Sans'] text-lg text-text-primary leading-tight">
                  {item.title}
                </p>
                {item.tematica.length > 0 && (
                  <div class="text-center flex flex-wrap gap-1.5 mt-auto content-baseline">
                    {item.tematica.map((t) => (
                    <span class="inline-block font-sans text-caption font-normal uppercase tracking-wide text-primary/60 bg-primary/10 rounded-md px-2.5 py-0.5">
                        {t}
                      </span>
                    ))}
                  </div>
                )}
              </div>
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="absolute bottom-4 left-4 right-4 flex items-center justify-between p-3 font-['Work_Sans'] text-sm md:text-body text-accent-magenta border border-accent-magenta rounded-md shadow-sm transition-colors duration-fast hover:bg-primary hover:text-text-inverse hover:border-primary"
                aria-label="Descargar publicación"
              >
                <span>DESCARGAR PDF</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3" />
                </svg>
              </a>
            </article>
          ))}
        </div>

        <div class="text-center mt-10">
          <a
            href="/novedades#publicaciones-section"
            class="inline-block font-sans text-caption font-bold uppercase tracking-wider text-text-inverse bg-primary rounded-pill px-8 py-3 no-underline hover:bg-accent-magenta transition-all duration-fast"
          >
            VER TODAS LAS PUBLICACIONES
          </a>
        </div>
      </div>
    </section>

    <!-- Newsletter -->
    <div class="mt-2 md:mt-6">
      <Newsletter decorated />
    </div>
  </main>

  <Footer />
</Layout>
